{
  "$schema": "https://plugins.dprint.dev/dprint/dprint-plugin-json/latest/schema.json",
  "excludes": [
    "**/*.sum",
    "**/.git/*"
  ],
  "includes": [
    "**/*.{json,jsonc}",
    "**/*.go",
    "**/*.md",
    "**/*.sh",
    "**/*.toml",
    "**/*.{yml,yaml}",
    "**/justfile"
  ],
  "lineWidth": 96,
  "indentWidth": 4,
  "plugins": [
    // https://github.com/dprint/dprint-plugin-exec/releases
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
    // https://github.com/dprint/dprint-plugin-json/releases
    "npm:@dprint/json@0.25.2@cefeda3078b93101a3ae1d46f70a69efaa3c2caa7a3107c6f7dad321fbd033e5",
    // https://github.com/dprint/dprint-plugin-markdown/releases
    "npm:@dprint/markdown@0.26.0@f22d576befb4511ba5d19ddd41414cb00a007db37e70cf0b27ece82b511f6caf",
    // https://github.com/dprint/dprint-plugin-toml/releases
    "npm:@dprint/toml@0.9.0@2cac97483311ab7e36373e02592b9757f9619f6aa2f7e232bb0a6bd143a75caa",
    // https://github.com/g-plane/pretty_yaml/releases
    "npm:dprint-plugin-yaml@0.6.0@aee3873f443c9f749521ea171cd38ed381491123aa4530684dd0d6e3deb6727b"
  ],
  "json": {
    // https://dprint.dev/plugins/json/config/
    "associations": ["**/*.{json,jsonc}"],
    "useTabs": false,
    "indentWidth": 2,
    "newLineKind": "lf",
    "lineWidth": 96,
    "trailingCommas": "never"
  },
  "exec": {
    "commands": [
      {
        "command": "gofmt",
        "exts": ["go"]
      },
      {
        "cwd": "${configDir}",
        "command": "just --dump --justfile {{file_path}}",
        "stdin": false,
        "fileNames": "justfile",
        "exts": [
          "justfile"
        ]
      },
      {
        "command": "shfmt",
        "exts": ["sh"]
      }
    ]
  },
  "markdown": {
    // https://dprint.dev/plugins/markdown/config
    "associations": ["**/*.md"],
    "lineWidth": 96
  },
  "toml": {
    "associations": ["**/*.toml"],
    "lineWidth": 96,
    "useTabs": false,
    "indentWidth": 4,
    "newLineKind": "lf",
    "comment.forceLeadingSpace": false
  },
  "yaml": {
    // https://dprint.dev/plugins/pretty_yaml/config
    "associations": ["**/*.{yaml,yml}"],
    "indentWidth": 2,
    "printWidth": 96
  }
}
